# ==============================================================================
# AI Usage Monitoring Lab — Environment Configuration Template
# Copy this file to .env before starting the lab:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Gateway (LiteLLM Proxy)
# ------------------------------------------------------------------------------
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-lab-master-key-admin-supersecret-9999
LITELLM_SALT_KEY=super-secret-salt-key-for-litellm-proxy

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL for LiteLLM & Keycloak)
# ------------------------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword123!
POSTGRES_DB=litellm
# Connection string LiteLLM uses (native Windows runs; docker-compose.yml builds its own)
DATABASE_URL=postgresql://postgres:postgrespassword123!@127.0.0.1:5432/litellm

# ------------------------------------------------------------------------------
# 3. Identity Provider (Keycloak OIDC)
# ------------------------------------------------------------------------------
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=adminpassword123!
# Local Keycloak install used by scripts/start_lab.ps1
KEYCLOAK_HOME=C:/keycloak-24.0.1

# ------------------------------------------------------------------------------
# 4. Mock AI Engine (Local OpenAI-compatible inference)
# ------------------------------------------------------------------------------
MOCK_AI_PORT=8001
# Where LiteLLM reaches the mock models (docker-compose.yml overrides this to http://mock-ai:8001/v1)
MOCK_AI_API_BASE=http://127.0.0.1:8001/v1

# ------------------------------------------------------------------------------
# 5. Local SIEM (Elasticsearch & Kibana)
# ------------------------------------------------------------------------------
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
# Elasticsearch runs with xpack.security enabled; scripts log in with these
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=change-me-elastic-password
# Password of the built-in kibana_system user (also set in kibana.yml)
KIBANA_SYSTEM_PASSWORD=change-me-kibana-system-password
DISCOVERY_TYPE=single-node
ES_JAVA_OPTS=-Xms512m -Xmx512m

# ------------------------------------------------------------------------------
# 6. Optional: Live External AI Providers (If not using Mock AI)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
